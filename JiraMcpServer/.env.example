# Copy to .env and fill in. Never commit .env.

# --- Jira Cloud (create a token at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=paste-your-jira-api-token

# --- Guard rails
# JSON list of project keys the assistant may access ([] = everything the Jira account can see)
JIRA_ALLOWED_PROJECTS=["ENG","OPS"]
# Write tools (create/comment/transition/assign) are refused while this is true
READ_ONLY=true
RATE_LIMIT_PER_MINUTE=120

# --- Who may call the MCP endpoint (Authorization: Bearer <key>). Store only SHA-256 hashes.
# Demo keys: dev-reader-key (read) and dev-writer-key (read+write). Generate your own with: jira-mcp-hash-key
MCP_API_KEYS=[{"name":"dev-reader","key_sha256":"839e4fbcc3a237c9545d3c35c8130fbc2183f569e9946037bae854a26bf83e22","scopes":["jira:read"]},{"name":"dev-writer","key_sha256":"16317a686fcc0b01095c59278bee1bb7eb6058f3047f67ef1e0e13782e840a42","scopes":["jira:read","jira:write"]}]

# --- Public URLs of this server (used in OAuth protected-resource metadata)
MCP_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_URL=http://localhost:8000/mcp
# Host/Origin allow-lists (DNS-rebinding protection). Add your DNS name when deployed.
MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*"]
MCP_ALLOWED_ORIGINS=["http://localhost:*","http://127.0.0.1:*"]

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false
